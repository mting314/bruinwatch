# Discord bot token (https://discord.com/developers/applications)
BRUINWATCH_DISCORD_TOKEN=

# Discord user ID of the bot owner; unlocks the /admin command group.
BRUINWATCH_OWNER_ID=

# Optional: sync slash commands to this guild instantly instead of waiting on
# the global (~1h) propagation. Great for development, leave unset in prod.
BRUINWATCH_DEV_GUILD_ID=

# Postgres. Must use the asyncpg driver.
BRUINWATCH_DATABASE_URL=postgresql+asyncpg://bruinwatch:bruinwatch@localhost:5432/bruinwatch

# Scraper politeness knobs.
BRUINWATCH_USER_AGENT=bruinwatch/2.0 (+https://github.com/mting314/speedchat-bot)
BRUINWATCH_MAX_CONCURRENCY=10
BRUINWATCH_REQUEST_TIMEOUT=20

# Set to false to run the bot without any background scraping (useful locally).
BRUINWATCH_SCHEDULER_ENABLED=true

BRUINWATCH_LOG_LEVEL=INFO
BRUINWATCH_HEALTHCHECK_PORT=8080
